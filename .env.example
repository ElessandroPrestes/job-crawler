APP_ENV=development
APP_DEBUG=false
APP_VERSION=1.0.0

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=job_crawler
DB_USERNAME=crawler
DB_PASSWORD=crawlersecret
DB_ROOT_PASSWORD=rootsecret

MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@jobcrawler.local
MAIL_FROM_NAME="Job Crawler"
MAIL_ENCRYPTION=

CRAWL_DELAY_MS=1500
CRAWL_MAX_PAGES=5
CRAWL_ALLOWED_DOMAINS=linkedin.com,indeed.com

LOG_LEVEL=info
LOG_PATH=/var/www/html/storage/logs/app.log

EXPORT_PATH=/var/www/html/storage/exports
